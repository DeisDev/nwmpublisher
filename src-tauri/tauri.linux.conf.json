{
	"$schema": "https://schema.tauri.app/config/2",
	"bundle": {
		"targets": ["appimage", "deb", "rpm"],
		"linux": {
			"appimage": {
				"bundleMediaFramework": true,
				"files": {
					"/usr/lib/nwmpublisher/libsteam_api.so": "lib/steam_api/redistributable_bin/linux64/libsteam_api.so",
					"/usr/bin/xdg-open": "/usr/bin/xdg-open",
					"/usr/bin/xdg-mime": "/usr/bin/xdg-mime",
					"/usr/bin/dbus-send": "/usr/bin/dbus-send"
				}
			},
			"deb": {
				"depends": [
					"libc6 (>= 2.35)", "libssl3", "libxdo3", "liblzma5",
					"ca-certificates", "dbus", "xdg-utils",
					"gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good",
					"gstreamer1.0-plugins-bad", "gstreamer1.0-libav"
				],
				"files": {
					"/usr/lib/nwmpublisher/libsteam_api.so": "lib/steam_api/redistributable_bin/linux64/libsteam_api.so",
					"/usr/share/doc/nwmpublisher/copyright": "../LICENSE"
				}
			},
			"rpm": {
				"depends": [
					"libc.so.6(GLIBC_2.35)(64bit)",
					"libssl.so.3()(64bit)",
					"libcrypto.so.3()(64bit)",
					"libxdo.so.3()(64bit)",
					"liblzma.so.5()(64bit)",
					"ca-certificates", "dbus-tools", "xdg-utils",
					"gstreamer1-plugins-base", "gstreamer1-plugins-good",
					"gstreamer1-plugins-bad-free", "gstreamer1-plugin-libav"
				],
				"files": {
					"/usr/lib/nwmpublisher/libsteam_api.so": "lib/steam_api/redistributable_bin/linux64/libsteam_api.so",
					"/usr/share/licenses/nwmpublisher/LICENSE": "../LICENSE"
				}
			}
		}
	}
}
