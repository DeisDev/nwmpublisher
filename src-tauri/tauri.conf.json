{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "nwmpublisher",
	"version": "3.1.1",
	"identifier": "nwmpublisher",
	"build": {
		"beforeDevCommand": "node src-tauri/copySharedLibs.js && npm run dev",
		"beforeBuildCommand": "node src-tauri/copySharedLibs.js && npm run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "nwmpublisher",
				"title": "nwmpublisher",
				"width": 800,
				"height": 600,
				"minWidth": 800,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"dragDropEnabled": true,
				"useHttpsScheme": true
			}
		],
		"security": {
			"csp": {
				"default-src": "'none'",
				"base-uri": "'none'",
				"object-src": "'none'",
				"frame-src": "'none'",
				"frame-ancestors": "'none'",
				"form-action": "'none'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"style-src-attr": "'unsafe-inline'",
				"style-src-elem": "'self' 'unsafe-inline'",
				"script-src-attr": "'none'",
				"img-src": "'self' data: blob: https:",
				"font-src": "'self'",
				"media-src": "'self'",
				"connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.github.com"
			},
			"devCsp": {
				"default-src": "'none'",
				"base-uri": "'none'",
				"object-src": "'none'",
				"frame-src": "'none'",
				"frame-ancestors": "'none'",
				"form-action": "'none'",
				"script-src": "'self'",
				"style-src": "'self' 'unsafe-inline'",
				"style-src-attr": "'unsafe-inline'",
				"style-src-elem": "'self' 'unsafe-inline'",
				"script-src-attr": "'none'",
				"img-src": "'self' data: blob: https:",
				"font-src": "'self'",
				"media-src": "'self'",
				"connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost https://api.github.com ws://localhost:1420"
			},
			"capabilities": [
				{
					"identifier": "main",
					"description": "Native APIs used by the main application window.",
					"windows": [
						"nwmpublisher"
					],
					"permissions": [
						"core:event:default",
						"dialog:allow-open",
						"dialog:allow-message",
						"clipboard-manager:allow-write-text",
						"shell:allow-open"
					]
				}
			]
		}
	},
	"bundle": {
		"active": true,
		"targets": [
			"msi"
		],
		"publisher": "DeisDev",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [],
		"externalBin": [],
		"copyright": "William Venner, DeisDev",
		"category": "DeveloperTool",
		"shortDescription": "Garry's Mod Workshop Publishing Utility",
		"longDescription": "Garry's Mod Workshop Publishing Utility",
		"windows": {
			"webviewInstallMode": {
				"type": "embedBootstrapper",
				"silent": true
			},
			"wix": {
				"template": "msi/msi.wxs"
			}
		}
	}
}
